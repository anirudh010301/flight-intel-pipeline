# ── Base image ───────────────────────────────────────────────
# Python 3.12 slim — lightweight, no unnecessary packages
# 'slim' variant is much smaller than the full Python image
FROM python:3.12-slim

# ── Working directory ────────────────────────────────────────
# All commands run from /app inside the container
# This is where our project files will live
WORKDIR /app

# ── System dependencies ──────────────────────────────────────
# gcc and g++ are needed to compile some Python packages
# We clean up apt cache after to keep image small
RUN apt-get update && \
    apt-get install -y gcc g++ && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────
# We copy requirements first — before copying code
# This is a Docker best practice called "layer caching"
# If requirements don't change, Docker skips this step on rebuild
COPY requirements.txt .

# Install only what FastAPI needs — not everything in requirements.txt
# This keeps the image small and avoids conflicts
RUN pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn==0.27.0 \
    psycopg2-binary==2.9.9 \
    pandas==2.2.0 \
    numpy==1.26.4 \
    scikit-learn==1.4.0 \
    joblib==1.3.2 \
    python-dotenv==1.0.1 \
    requests==2.31.0 \
    loguru==0.7.2

# ── Copy project files ───────────────────────────────────────
# Copy only what FastAPI needs — not the entire project
# This keeps the image lean
COPY api/ ./api/
COPY ml/ ./ml/
COPY lineage/ ./lineage/
COPY .env .env

# ── Create necessary directories ─────────────────────────────
RUN mkdir -p ml/models ml/charts

# ── Expose port ──────────────────────────────────────────────
# Tell Docker this container listens on port 8000
# This must match the port in docker-compose.yml
EXPOSE 8000

# ── Start command ────────────────────────────────────────────
# This runs when the container starts
# --host 0.0.0.0 means accept connections from outside the container
# Without this, FastAPI would only accept localhost connections
# and other containers couldn't reach it
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]